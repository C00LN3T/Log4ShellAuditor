# Stage 1: Build the Go agent
FROM golang:1.21-alpine AS go-build
WORKDIR /app
COPY go.mod .
COPY . .
RUN go build -o agent ./cmd/agent

# Stage 2: Compile the Java Exploit payload
FROM eclipse-temurin:17-jdk-alpine AS java-build
WORKDIR /app
COPY internal/payload/Exploit.java .
RUN javac Exploit.java

# Stage 3: Package together
FROM golang:1.21-alpine
WORKDIR /app
RUN apk add --no-cache curl
COPY --from=go-build /app/agent .
COPY --from=java-build /app/Exploit.class .
ENTRYPOINT ["./agent"]
